# Public viewer address used by links from internal applications.
VIEWER_PUBLIC_URL=http://viewer.internal

# Comma-separated host names or shell-style patterns. Never leave "*" in production.
SOURCE_ALLOWED_HOSTS=*.s3.internal,storage.internal
SOURCE_ALLOWED_PORTS=80,443
SOURCE_ALLOWED_SCHEMES=http,https
# Exact hostnames only. TLS certificate verification is disabled for these hosts.
# Prefer installing the internal CA; leave empty unless an exception is unavoidable.
SOURCE_TLS_INSECURE_HOSTS=

CACHE_TTL_SECONDS=86400
FAILED_TTL_SECONDS=3600
MAX_SOURCE_BYTES=536870912
MAX_OFFICE_BYTES=209715200
MAX_ARCHIVE_BYTES=536870912
MAX_EXTRACTED_BYTES=2147483648
MAX_ARCHIVE_ENTRIES=10000
MAX_NESTING_DEPTH=3
MAX_CONCURRENT_CONVERSIONS=2
